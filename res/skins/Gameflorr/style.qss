/* Generated by Codex (AI). Compact Extended layout. End of AI-generated text. */
#GameflorrWorkspace { background: #090909; color: #d9d9d9; font-family: "DejaVu Sans", sans-serif; font-size: 11px; }
#GameflorrWorkspace * { text-transform: none; }
#GameflorrToolbar { background: #202020; padding: 2px 8px; border-bottom: 1px solid #454545; qproperty-layoutSpacing: 4; }
#GameflorrBrand { color: #f0f0f0; font-size: 14px; font-weight: bold; }
#GameflorrViewName, #GameflorrClock { color: #a8a8a8; font-size: 10px; }
#GameflorrHelp { background: #202020; padding: 4px 10px; border-bottom: 1px solid #454545; }
#GameflorrStep { color: #6ab9e6; font-size: 10px; }
#GameflorrHelpText, #GameflorrSetupHint { color: #ccc; font-size: 10px; }
#GameflorrDecks { background: #101010; padding: 2px 6px; qproperty-layoutSpacing: 6; }
#GameflorrDeck1, #GameflorrDeck2 { background: #101010; border: none; qproperty-layoutSpacing: 5; }
#GameflorrDeckBody { padding: 0px 3px; qproperty-layoutSpacing: 2; }
#GameflorrDeckNumber { color: #72c7fa; background: #152733; border: 1px solid #3985b5; font-size: 14px; font-weight: bold; }
#GameflorrTitle { color: #f0f0f0; font-size: 13px; font-weight: bold; background: transparent; padding-left: 5px; }
#GameflorrArtist { color: #b3b3b3; font-size: 11px; background: transparent; }
#GameflorrTime { color: #d9d9d9; font-size: 11px; padding: 0px; }
#GameflorrSectionLabel, #GameflorrUnit { color: #929292; font-size: 9px; }
#GameflorrTrackInfo WKey { color: #e1a9e8; font-size: 12px; padding: 0px; }
#GameflorrPads, #GameflorrLoops, #GameflorrTransport { qproperty-layoutSpacing: 3; }
#GameflorrNav, #GameflorrLoad, #GameflorrCue, #GameflorrPlay, #GameflorrHeadphone, #GameflorrLoop, #GameflorrHotcue, #GameflorrSync, #GameflorrKeylock, #GameflorrNudge {
  background: #191919; color: #bcbcbc; border: 1px solid #414141; border-radius: 1px; font-size: 10px; font-weight: normal;
}
#GameflorrNav:hover, #GameflorrLoad:hover, #GameflorrCue:hover, #GameflorrPlay:hover, #GameflorrHeadphone:hover, #GameflorrLoop:hover, #GameflorrHotcue:hover, #GameflorrSync:hover, #GameflorrKeylock:hover, #GameflorrNudge:hover { background: #303030; border-color: #888; color: #fff; }
#GameflorrNav[displayValue="1"], #GameflorrHeadphone[displayValue="1"], #GameflorrLoop[displayValue="1"], #GameflorrSync[displayValue="1"], #GameflorrKeylock[displayValue="1"] { background: #225574; color: #fff; border-color: #69a9d1; }
#GameflorrPlay { color: #8fda66; font-size: 17px; }
#GameflorrPlay[displayValue="1"] { color: #a8ed7b; border-color: #73b34f; background: #223019; }
#GameflorrCue[displayValue="1"] { color: #efb952; border-color: #b88735; background: #302719; }
#GameflorrHotcue { background: #111; border: 1px solid #333; color: #777; text-align: left; padding-left: 8px; }
#GameflorrHotcue[displayValue="1"], #GameflorrHotcue[displayValue="2"] { color: #fff; border: 1px solid #aaa; }
#GameflorrHotcue[light="true"] { color: #101010; }
#GameflorrHotcue[dark="true"] { color: #fff; }
#GameflorrPlatterColumn { qproperty-layoutSpacing: 2; }
#GameflorrPlatterBpm { background: transparent; color: #f2f5f7; font-size: 22px; font-weight: bold; padding: 0px; }
#GameflorrPlatterUnit { background: transparent; color: #9da8b3; font-size: 10px; }
#GameflorrPlatterRate { background: transparent; color: #b5bec7; font-size: 10px; padding: 0px; }
#GameflorrPlatterTime { background: transparent; color: #e0e8f0; font-size: 12px; padding: 0px; qproperty-wordWrap: true; }
#GameflorrCompactMixer { background: #151515; border-left: 1px solid #333; border-right: 1px solid #333; padding: 0px 2px; }
#MixerBorder, #Mixer { background: #141414; border-radius: 0px; }
#GameflorrAdvanced { padding-top: 3px; border-top: 1px solid #333; }
#GameflorrWaveforms { background: #050505; border-top: 1px solid #3c3c3c; border-bottom: 1px solid #3c3c3c; qproperty-layoutSpacing: 1; }
#WaveformZoomContainer { background: #151515; }

/* Generated by Codex (AI). Horizontal performance hierarchy. End of AI-generated text. */
#GameflorrHorizontal { background: #0b0d10; padding: 8px 6px; qproperty-layoutSpacing: 8; }
#GameflorrHorizontalDeck { background: #121518; border: 1px solid #30363e; padding: 6px; qproperty-layoutSpacing: 5; }
#GameflorrDeckTools { qproperty-layoutSpacing: 8; }
#GameflorrHorizontalDeck #GameflorrTitle { font-size: 14px; }
#GameflorrHorizontalDeck #GameflorrLoad { font-size: 9px; }
#GameflorrSectionLabel { color: #919eab; font-size: 9px; padding-left: 4px; }
#GameflorrWaveformHeader { background: #171b20; border-bottom: 1px solid #30363e; }
#GameflorrHorizontalMixer { background: #121518; }
#GameflorrPerformanceSplit::handle { background: #343c46; height: 5px; }
#GameflorrPerformanceSplit::handle:hover { background: #58b5ed; }

/* AI-generated text begins. Performance pad modes. AI-generated text ends. */
#GameflorrPadMode { background: #191d22; color: #adb8c5; border: 1px solid #38414c; font-size: 9px; }
#GameflorrPadMode[displayValue="1"] { background: #285e7c; color: white; border-color: #6ec7ed; }
#GameflorrPadHint { color: #d6aa70; font-size: 9px; }
#GameflorrSamplerPanel { padding: 5px; qproperty-layoutSpacing: 5; background: #11161c; }
#GameflorrSamplerSlot { border: 1px solid #36414c; padding: 4px; background: #181e25; qproperty-layoutSpacing: 3; }
#GameflorrPad0 { background: #171c22; color: #4f9dcd; border: 1px solid #4f9dcd; border-radius: 2px; font-size: 11px; }
#GameflorrPad0[displayValue="1"] { background: #4f9dcd; color: #0a1016; }
#GameflorrPad0:hover { border: 1px solid white; }
#GameflorrPad1 { background: #171c22; color: #b877db; border: 1px solid #b877db; border-radius: 2px; font-size: 11px; }
#GameflorrPad1[displayValue="1"] { background: #b877db; color: #0a1016; }
#GameflorrPad1:hover { border: 1px solid white; }
#GameflorrPad2 { background: #171c22; color: #d59d42; border: 1px solid #d59d42; border-radius: 2px; font-size: 11px; }
#GameflorrPad2[displayValue="1"] { background: #d59d42; color: #0a1016; }
#GameflorrPad2:hover { border: 1px solid white; }
#GameflorrPad3 { background: #171c22; color: #65ae75; border: 1px solid #65ae75; border-radius: 2px; font-size: 11px; }
#GameflorrPad3[displayValue="1"] { background: #65ae75; color: #0a1016; }
#GameflorrPad3:hover { border: 1px solid white; }
#GameflorrPad4 { background: #171c22; color: #c37853; border: 1px solid #c37853; border-radius: 2px; font-size: 11px; }
#GameflorrPad4[displayValue="1"] { background: #c37853; color: #0a1016; }
#GameflorrPad4:hover { border: 1px solid white; }
#GameflorrPad5 { background: #171c22; color: #67b5b6; border: 1px solid #67b5b6; border-radius: 2px; font-size: 11px; }
#GameflorrPad5[displayValue="1"] { background: #67b5b6; color: #0a1016; }
#GameflorrPad5:hover { border: 1px solid white; }
#GameflorrPad6 { background: #171c22; color: #d59d42; border: 1px solid #d59d42; border-radius: 2px; font-size: 11px; }
#GameflorrPad6[displayValue="1"] { background: #d59d42; color: #0a1016; }
#GameflorrPad6:hover { border: 1px solid white; }
