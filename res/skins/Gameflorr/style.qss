/* Generated by Codex (AI). Gameflorr appearance over Deere controls. End of AI-generated text. */
#GameflorrWorkspace { background: #0c111b; color: #edf2fa; font-family: "DejaVu Sans", sans-serif; font-size: 12px; }
#GameflorrWorkspace * { text-transform: none; }
#GameflorrToolbar { background: #131c2a; padding: 8px 12px; border-bottom: 1px solid #2b3b50; qproperty-layoutSpacing: 6; }
#GameflorrBrand { color: #f3f7ff; font-size: 18px; font-weight: bold; }
#GameflorrSubtitle { color: #8ca2bf; font-size: 9px; }
#GameflorrClock { color: #c4d2e5; font-size: 13px; }
#GameflorrHelp { background: #162234; padding: 6px 12px; border-bottom: 1px solid #263b54; }
#GameflorrStep { color: #9ac8ff; font-weight: bold; font-size: 11px; }
#GameflorrHelpText { color: #dce7f7; font-size: 11px; }
#GameflorrSetupHint { color: #91a8c6; font-size: 10px; }
#GameflorrDecks { background: #0c111b; qproperty-layoutSpacing: 8; padding: 8px; }
#GameflorrDeck1, #GameflorrDeck2 { background: #172130; border: 1px solid #304158; border-radius: 6px; }
#GameflorrDeck1 { border-top: 3px solid #38bdf8; }
#GameflorrDeck2 { border-top: 3px solid #fb923c; }
#GameflorrDeckBody { padding: 8px; qproperty-layoutSpacing: 4; }
#GameflorrDeckNumber { color: #0a1421; background: #38bdf8; border-radius: 4px; font-size: 18px; font-weight: bold; }
#GameflorrDeck2 #GameflorrDeckNumber { background: #fb923c; }
#GameflorrDeckHint { color: #8499b4; font-size: 9px; padding-left: 7px; }
#GameflorrTitle { color: #ffffff; font-size: 18px; font-weight: bold; background: transparent; }
#GameflorrArtist { color: #aebfd5; font-size: 12px; background: transparent; }
#GameflorrTime { font-size: 15px; }
#GameflorrBpm { color: #e6efff; font-size: 19px; font-weight: bold; }
#GameflorrUnit { color: #90a6c3; font-size: 10px; }
#GameflorrTrackInfo, #GameflorrPads, #GameflorrTransport { qproperty-layoutSpacing: 5; }
#GameflorrNav, #GameflorrLoad, #GameflorrCue, #GameflorrPlay, #GameflorrHeadphone, #GameflorrLoop, #GameflorrHotcue {
  background: #223047; color: #dbe7f7; border: 1px solid #3a506c; border-radius: 4px; font-size: 11px; font-weight: bold;
}
#GameflorrNav:hover, #GameflorrLoad:hover, #GameflorrCue:hover, #GameflorrPlay:hover, #GameflorrHeadphone:hover, #GameflorrLoop:hover, #GameflorrHotcue:hover { background: #344a69; border-color: #9ab7df; }
#GameflorrNav[value="1"], #GameflorrHeadphone[value="1"], #GameflorrLoop[value="1"] { background: #29527a; color: #ffffff; border-color: #5dbbff; }
#GameflorrPlay { background: #194139; color: #b7f7d5; border-color: #2c8968; }
#GameflorrPlay[value="1"] { background: #2b9d71; color: #071c14; border-color: #6ef2ad; }
#GameflorrCue[value="1"] { background: #a86721; color: #ffffff; border-color: #ffca7a; }
#GameflorrHotcue[value="1"], #GameflorrHotcue[value="2"] { border: 2px solid #d8e8ff; }
#GameflorrTempo { padding: 8px 4px; background: #131d2c; border-left: 1px solid #304158; }
#GameflorrAdvanced { padding-top: 6px; border-top: 1px solid #3b4d66; }
#MixerBorder, #Mixer { background: #111b29; border-radius: 4px; }
#Waveforms { background: #0c111b; padding: 6px 8px 0px 8px; }

#GameflorrHeadphone { min-height: 40px; }

#GameflorrTrackInfo WKey { color: #e6efff; font-size: 15px; padding: 0px; }
