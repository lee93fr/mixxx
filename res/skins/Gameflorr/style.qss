/* Generated by Codex (AI). Compact Extended layout. End of AI-generated text. */
#GameflorrWorkspace { background: #090909; color: #d9d9d9; font-family: "DejaVu Sans", sans-serif; font-size: 11px; }
#GameflorrWorkspace * { text-transform: none; }
#GameflorrToolbar { background: #202020; padding: 3px 8px; border-bottom: 1px solid #454545; qproperty-layoutSpacing: 4; }
#GameflorrBrand { color: #f0f0f0; font-size: 14px; font-weight: bold; }
#GameflorrViewName, #GameflorrClock { color: #a8a8a8; font-size: 10px; }
#GameflorrHelp { background: #202020; padding: 4px 10px; border-bottom: 1px solid #454545; }
#GameflorrStep { color: #6ab9e6; font-size: 10px; }
#GameflorrHelpText, #GameflorrSetupHint { color: #ccc; font-size: 10px; }
#GameflorrDecks { background: #101010; padding: 4px 6px; qproperty-layoutSpacing: 6; }
#GameflorrDeck1, #GameflorrDeck2 { background: #101010; border: none; qproperty-layoutSpacing: 8; }
#GameflorrDeckBody { padding: 0px 3px; qproperty-layoutSpacing: 3; }
#GameflorrDeckNumber { color: #72c7fa; background: #152733; border: 1px solid #3985b5; font-size: 14px; font-weight: bold; }
#GameflorrTitle { color: #f0f0f0; font-size: 15px; font-weight: bold; background: transparent; padding-left: 5px; }
#GameflorrArtist { color: #b3b3b3; font-size: 11px; background: transparent; }
#GameflorrTime { color: #d9d9d9; font-size: 11px; padding: 0px; }
#GameflorrSectionLabel, #GameflorrUnit { color: #929292; font-size: 9px; }
#GameflorrTrackInfo WKey { color: #e1a9e8; font-size: 12px; padding: 0px; }
#GameflorrPads, #GameflorrLoops, #GameflorrTransport { qproperty-layoutSpacing: 3; }
#GameflorrNav, #GameflorrLoad, #GameflorrCue, #GameflorrPlay, #GameflorrHeadphone, #GameflorrLoop, #GameflorrHotcue, #GameflorrSync, #GameflorrKeylock, #GameflorrNudge {
  background: #191919; color: #bcbcbc; border: 1px solid #414141; border-radius: 1px; font-size: 10px; font-weight: normal;
}
#GameflorrNav:hover, #GameflorrLoad:hover, #GameflorrCue:hover, #GameflorrPlay:hover, #GameflorrHeadphone:hover, #GameflorrLoop:hover, #GameflorrHotcue:hover, #GameflorrSync:hover, #GameflorrKeylock:hover, #GameflorrNudge:hover { background: #303030; border-color: #888; color: #fff; }
#GameflorrNav[value="1"], #GameflorrHeadphone[value="1"], #GameflorrLoop[value="1"], #GameflorrSync[value="1"], #GameflorrKeylock[value="1"] { background: #225574; color: #fff; border-color: #69a9d1; }
#GameflorrPlay { color: #8fda66; font-size: 17px; }
#GameflorrPlay[value="1"] { color: #a8ed7b; border-color: #73b34f; background: #223019; }
#GameflorrCue[value="1"] { color: #efb952; border-color: #b88735; background: #302719; }
#GameflorrHotcue { background: #111; border: 1px solid #333; color: #777; text-align: left; padding-left: 8px; }
#GameflorrHotcue[value="1"], #GameflorrHotcue[value="2"] { color: #fff; border: 1px solid #aaa; }
#GameflorrPlatterColumn { qproperty-layoutSpacing: 2; }
#GameflorrPlatterBpm { background: #eeeeec; color: #111; font-size: 25px; font-weight: bold; padding: 0px; }
#GameflorrPlatterUnit { background: #eeeeec; color: #777; font-size: 9px; }
#GameflorrPlatterRate { background: #eeeeec; color: #333; font-size: 11px; padding: 0px; }
#GameflorrCompactMixer { background: #151515; border-left: 1px solid #333; border-right: 1px solid #333; padding: 0px 2px; }
#MixerBorder, #Mixer { background: #141414; border-radius: 0px; }
#GameflorrAdvanced { padding-top: 3px; border-top: 1px solid #333; }
#GameflorrWaveforms { background: #050505; border-top: 1px solid #3c3c3c; border-bottom: 1px solid #3c3c3c; qproperty-layoutSpacing: 1; }
#WaveformZoomContainer { background: #151515; }
