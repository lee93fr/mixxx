/* Generated by Codex (AI). Dark collection with compact search. End of AI-generated text. */
WLibraryTableView, WTrackTableView, WLibrarySidebar, WLibraryTextBrowser { background-color: #101010; alternate-background-color: #181818; color: #ccc; font-size: 11px; selection-background-color: #245575; selection-color: #fff; border: none; }
WLibrarySidebar::item { height: 23px; }
WTrackTableViewHeader::section { background: #252525; color: #bcbcbc; border: none; border-bottom: 1px solid #414141; padding: 3px; font-size: 10px; }
#GameflorrSearch { background: #252525; border-bottom: 1px solid #3c3c3c; padding: 2px 6px; }
#GameflorrCollectionLabel { color: #9d9d9d; font-size: 10px; }
WSearchLineEdit, WSearchLineEdit QLineEdit { background: #111; color: #ddd; font-size: 11px; min-height: 22px; border: 1px solid #4a4a4a; border-radius: 1px; }
