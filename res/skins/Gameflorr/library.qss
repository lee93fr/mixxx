/* Generated by Codex (AI). Performance library hierarchy. End of AI-generated text. */
WLibraryTableView, WTrackTableView, WLibrarySidebar, WLibraryTextBrowser { background-color: #101316; alternate-background-color: #191d22; color: #d3dce4; font-size: 12px; selection-background-color: #235371; selection-color: #fff; border: none; }
WTrackTableView { qproperty-trackPlayedColor: #98a5b2; }
WLibrarySidebar::item { height: 26px; }
WLibrarySidebar::item:selected { background: #235371; color: #fff; }
WTrackTableViewHeader::section { background: #232a32; color: #bcc7d2; border: none; border-bottom: 1px solid #414c58; padding: 5px; font-size: 11px; }
#GameflorrSearch { background: #191e24; border-bottom: 1px solid #343c46; padding: 4px 6px; qproperty-layoutSpacing: 6; }
#GameflorrCollectionLabel { color: #b8c5d1; font-size: 11px; font-weight: bold; }
WSearchLineEdit, WSearchLineEdit QLineEdit { background: #0c0f12; color: #e2eaf2; font-size: 12px; min-height: 28px; border: 1px solid #414c58; border-radius: 2px; }
#GameflorrLibraryLoad { background: #252d36; color: #e2eaf2; border: 1px solid #485664; border-radius: 2px; font-size: 11px; }
#GameflorrLibraryLoad:hover { background: #34516b; border-color: #58b5ed; }
