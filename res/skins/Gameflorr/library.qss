/* Generated by Codex (AI). Library colors and search. End of AI-generated text. */
WLibraryTableView, WTrackTableView, WLibrarySidebar, WLibraryTextBrowser {
  background-color: #111a28; alternate-background-color: #172335; color: #dce7f7;
  font-size: 12px; selection-background-color: #28496e; selection-color: #ffffff;
  border: 1px solid #2b3b50;
}
WLibrarySidebar::item { height: 24px; }
WTrackTableViewHeader::section { background: #1c2a3e; color: #a9bfdc; border: none; border-bottom: 1px solid #354b68; padding: 5px; }
WSearchLineEdit, WSearchLineEdit QLineEdit { background: #1b2b40; color: #ffffff; font-size: 13px; min-height: 28px; border: 1px solid #425c7d; border-radius: 4px; }
