<!DOCTYPE template>
<!-- Generated by Codex (AI). Fork interface with local scan, vertical and compact adaptations. End of AI-generated text. -->
<Template>
  <WidgetGroup>
    <ObjectName>GameflorrToolbar</ObjectName>
    <Layout>horizontal</Layout>
    <SizePolicy>me,f</SizePolicy>
    <Children>
      <Label>
        <ObjectName>GameflorrBrand</ObjectName>
        <Text>GAMEFLORR</Text>
        <Size>104f,24f</Size>
      </Label>
      <Template src="skins:Gameflorr/view_button.xml">
        <SetVariable name="view">0</SetVariable>
        <SetVariable name="text">Horizontal</SetVariable>
        <SetVariable name="tip">Platines latérales et formes d’onde au centre.</SetVariable>
      </Template>
      <Template src="skins:Gameflorr/view_button.xml">
        <SetVariable name="view">1</SetVariable>
        <SetVariable name="text">Extended</SetVariable>
        <SetVariable name="tip">Formes d’onde sur toute la largeur.</SetVariable>
      </Template>
      <Template src="skins:Gameflorr/view_button.xml">
        <SetVariable name="view">2</SetVariable>
        <SetVariable name="text">Vertical</SetVariable>
        <SetVariable name="tip">Formes d’onde verticales et vumètres au centre.</SetVariable>
      </Template>
      <Template src="skins:Gameflorr/button.xml">
        <SetVariable name="name">GameflorrNav</SetVariable>
        <SetVariable name="size">70f,22f</SetVariable>
        <SetVariable name="text">Compacte</SetVariable>
        <SetVariable name="control">[GameflorrSkin],compact</SetVariable>
        <SetVariable name="tip">Masquer les cadrans et réduire les formes d’onde horizontales. BPM, temps, pitch et PFL restent disponibles.</SetVariable>
      </Template>
      <Template src="skins:Gameflorr/button.xml">
        <SetVariable name="name">GameflorrNav</SetVariable>
        <SetVariable name="size">100f,22f</SetVariable>
        <SetVariable name="text">Bibliothèque</SetVariable>
        <SetVariable name="control">[Skin],show_maximized_library</SetVariable>
        <SetVariable name="tip">Agrandir la bibliothèque ou revenir à la vue de mixage.</SetVariable>
      </Template>
      <Template src="skins:Gameflorr/button.xml">
        <SetVariable name="name">GameflorrNav</SetVariable>
        <SetVariable name="size">58f,22f</SetVariable>
        <SetVariable name="text">Stems</SetVariable>
        <SetVariable name="control">[Skin],show_stem_controls</SetVariable>
        <SetVariable name="tip">Afficher les commandes des quatre stems sur les titres préparés.</SetVariable>
      </Template>
      <Template src="skins:Gameflorr/panel_button.xml">
        <SetVariable name="panel">1</SetVariable>
        <SetVariable name="name">GameflorrNav</SetVariable>
        <SetVariable name="size">42f,22f</SetVariable>
        <SetVariable name="text">FX</SetVariable>
        <SetVariable name="tip">Afficher ou masquer les effets.</SetVariable>
      </Template>
      <Template src="skins:Gameflorr/button.xml">
        <SetVariable name="name">GameflorrNav</SetVariable>
        <SetVariable name="size">74f,22f</SetVariable>
        <SetVariable name="text">Sampler</SetVariable>
        <SetVariable name="control">[GameflorrSkin],sampler_visible</SetVariable>
        <SetVariable name="tip">Afficher ou masquer les huit samples.</SetVariable>
      </Template>
      <Template src="skins:Gameflorr/panel_button.xml">
        <SetVariable name="panel">3</SetVariable>
        <SetVariable name="name">GameflorrNav</SetVariable>
        <SetVariable name="size">60f,22f</SetVariable>
        <SetVariable name="text">Détails</SetVariable>
        <SetVariable name="tip">Afficher ou masquer les boucles et réglages avancés.</SetVariable>
      </Template>
      <WidgetGroup>
        <Layout>horizontal</Layout>
        <SizePolicy>min,max</SizePolicy>
        <Connection>
          <ConfigKey>[GameflorrSkin],view</ConfigKey>
          <BindProperty>visible</BindProperty>
          <Transform>
            <IsEqual>2</IsEqual>
            <Not />
          </Transform>
        </Connection>
        <Children>
          <Template src="skins:Gameflorr/button.xml">
            <SetVariable name="name">GameflorrNav</SetVariable>
            <SetVariable name="size">64f,22f</SetVariable>
            <SetVariable name="text">Mixeur</SetVariable>
            <SetVariable name="control">[GameflorrSkin],mixer</SetVariable>
            <SetVariable name="tip">Afficher les égaliseurs et le mixeur complet. En vue Horizontal, le bouton affiche aussi les faders.</SetVariable>
          </Template>
        </Children>
      </WidgetGroup>
      <WidgetGroup>
        <Size>0me,0f</Size>
      </WidgetGroup>
      <Template src="skins:Deere/knob_medium_optional_label.xml">
        <SetVariable name="TooltipId">headphone_gain</SetVariable>
        <SetVariable name="group">[Master]</SetVariable>
        <SetVariable name="control">headGain</SetVariable>
        <SetVariable name="color">blue</SetVariable>
        <SetVariable name="label">Casque</SetVariable>
      </Template>
      <Template src="skins:Deere/knob_medium_optional_label.xml">
        <SetVariable name="TooltipId">headMix</SetVariable>
        <SetVariable name="group">[Master]</SetVariable>
        <SetVariable name="control">headMix</SetVariable>
        <SetVariable name="color">blue</SetVariable>
        <SetVariable name="label">Mix</SetVariable>
      </Template>
      <Template src="skins:Deere/knob_medium_optional_label.xml">
        <SetVariable name="TooltipId">main_gain</SetVariable>
        <SetVariable name="group">[Master]</SetVariable>
        <SetVariable name="control">gain</SetVariable>
        <SetVariable name="color">green</SetVariable>
        <SetVariable name="label">Master</SetVariable>
      </Template>
      <Template src="skins:Gameflorr/button.xml">
        <SetVariable name="name">GameflorrNav</SetVariable>
        <SetVariable name="size">28f,22f</SetVariable>
        <SetVariable name="text">?</SetVariable>
        <SetVariable name="control">[GameflorrSkin],help</SetVariable>
        <SetVariable name="tip">Afficher ou masquer l’aide et les réglages de départ.</SetVariable>
      </Template>
      <Time>
        <ObjectName>GameflorrClock</ObjectName>
        <Size>58f,22f</Size>
      </Time>
    </Children>
  </WidgetGroup>
</Template>
